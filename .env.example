# Salin menjadi .env.local lalu isi dari Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# RAHASIA: hanya dipakai di server (route handler). Jangan diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Email akun admin (dibuat di Supabase > Authentication > Users)
ADMIN_EMAIL=anda@contoh.com
